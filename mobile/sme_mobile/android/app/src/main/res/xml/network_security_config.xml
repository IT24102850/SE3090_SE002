<?xml version="1.0" encoding="utf-8"?>
<!--
  What the app is allowed to talk to in plain HTTP.

  Android 9 (API 28) and later block cleartext by default, which is the right
  default: this app carries a session token on every request and a payment
  flow on some of them, and neither belongs on an unencrypted connection over
  a phone network. The deployed API is HTTPS, so production needs no exception
  at all.

  The exceptions below exist only so a build can be pointed at a backend
  running on a developer's own machine, which has no certificate:

    10.0.2.2   the host machine, as seen from the Android emulator
    localhost  the device itself (a port-forwarded backend, `adb reverse`)

  To demo on a physical phone against a laptop on the same Wi-Fi, add that
  laptop's LAN address here as another <domain> - for example
  192.168.1.42 - and rebuild. It has to be the literal address: this file
  matches hostnames, not ranges.

  Do not replace this with android:usesCleartextTraffic="true". That turns
  cleartext on for every host the app will ever contact, including the real
  API, and nothing then warns you if a production URL loses its https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
