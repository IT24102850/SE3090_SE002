{
  "functions": {
    "api/claude-mcp.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/claude-mcp?route=mcp"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/claude-mcp?route=register"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/claude-mcp?route=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/claude-mcp?route=token"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/claude-mcp?route=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/claude-mcp?route=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/claude-mcp?route=asm"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/claude-mcp?route=asm"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/claude-mcp?route=asm"
    },
    {
      "source": "/connector/docs",
      "destination": "/connector/docs.html"
    },
    {
      "source": "/connector/privacy",
      "destination": "/connector/privacy.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sme-backend-lxsp.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
