# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash/-pro (originally pinned here) 404 "no longer available to
# new users" as of 2026-08-15 - new free-tier keys only get Flash-family
# models, and Pro needs billing enabled (429 limit:0 otherwise). Using the
# -latest alias instead of pinning avoids repeating this break; swap
# GEMINI_MODEL_PLANNER for a pro model once billing is enabled, since the
# Planner benefits from the stronger reasoning.
GEMINI_MODEL_DEFAULT=gemini-3.5-flash
GEMINI_MODEL_PLANNER=gemini-3.5-flash

# The billing copilot's two edges. Both fall back to GEMINI_MODEL_DEFAULT, and
# both degrade to a deterministic path when every model in the chain is down -
# the billing anomaly detection itself never calls a model at all (ADR-007).
GEMINI_MODEL_BILLING_PLANNER=gemini-3.5-flash
GEMINI_MODEL_BILLING_NARRATOR=gemini-3.5-flash

# Free-tier Gemini fails per-model, so the client retries transient errors
# (503/429/5xx) on the same model and then walks this chain. Measured
# 2026-09-24: gemini-3.5-flash ~6s, gemini-flash-lite-latest ~7s,
# gemini-flash-latest ~22s and intermittently 503 "high demand". A 404
# (model not available to this key) skips to the next entry without retrying.
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-flash-latest
GEMINI_MAX_ATTEMPTS=3
GEMINI_BACKOFF_SECONDS=0.6

# The ASP.NET Core API this service calls back into for every tool.
BACKEND_API_BASE_URL=http://localhost:5298/api

# Shared secret ASP.NET Core must send as `Authorization: Bearer <token>` on
# every request to this service. Generate any long random string.
AGENT_SERVICE_INTERNAL_TOKEN=

# Deterministic Validation/Safety Agent thresholds.
APPROVAL_BOOKING_COUNT_THRESHOLD=20
APPROVAL_REVENUE_THRESHOLD=500
MAX_APPOINTMENT_DURATION_MINUTES=120

# Per-Gemini-call timeout (seconds) and max tool-calling loop turns.
GEMINI_TIMEOUT_SECONDS=30
MAX_AGENT_TURNS=6

# Inventory replenishment planning assumptions (overridden when real supplier
# lead-time data is integrated; the assistant flags these assumptions in output).
INVENTORY_DEFAULT_LEAD_TIME_DAYS=7
INVENTORY_DEFAULT_SAFETY_DAYS=7

# LLM provider switch - "gemini" (default) or "ollama". See llm_client.py.
# The Ollama options below only take effect once you've installed Ollama
# (https://ollama.com) and pulled a tool-capable model yourself - nothing in
# this project installs or runs Ollama for you.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3.1
OLLAMA_MODEL_PLANNER=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
